# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# You're missing this one (has .flutter-plugins-dependencies but not the base file)
.flutter-plugins

# Android signing (add if/when you set up release builds)
android/key.properties
android/app/*.jks
android/app/*.keystore

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/

# macOS/Windows/Linux (harmless to include even if you don't build for them)
macos/Flutter/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/

# Env files (for when you add real secrets later)
.env
.env.*
*.env